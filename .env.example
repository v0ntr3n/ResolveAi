# Core Configuration
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URL=sqlite:///./data/orders.db
VECTOR_INDEX_DIR=./data/vector_index
AUTO_SEED_DATA=true
REFUND_APPROVAL_THRESHOLD=50.0

# Embedding Configuration (supports llama.cpp server)
# Option 1: Use llama.cpp server for local embeddings
# EMBEDDING_API_BASE=http://localhost:8080/v1
# EMBEDDING_MODEL=local-embedding-model
# EMBEDDING_API_KEY= (optional for local servers)
# Option 2: Use OpenAI embeddings (set OPENAI_API_KEY below)
# Option 3: Use DeepSeek embeddings (set DEEPSEEK_API_KEY above)
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_API_KEY=

# Week 3: LangSmith Tracing (Optional - for detailed workflow visibility)
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=resolveai-production
LANGSMITH_ORG=your_org_id

# Week 3: RAGAS Evaluation (Required for RAG quality metrics)
OPENAI_API_KEY=your_openai_key_here

# Week 3: Prometheus Metrics
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# CORS Configuration for Frontend Integration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true
